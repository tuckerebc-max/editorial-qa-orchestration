{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/eqa/finding.schema.json",
  "title":"EQA Typed Finding",
  "type":"object",
  "additionalProperties":false,
  "required":["finding_id","family","skill_id","status","location","observed","expected","authority","evidence","severity","confidence","intervention","dependencies","owner","state_history"],
  "properties":{
    "finding_id":{"type":"string","pattern":"^EQA-FND-"},"family":{"type":"string"},"skill_id":{"type":"string"},"status":{"type":"string"},"location":{"type":"string"},"observed":{"type":"string"},"expected":{"type":["string","null"]},"authority":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},"severity":{"type":"string","enum":["low","moderate","high","critical"]},"confidence":{"type":"string","enum":["high","moderate","low","unknown"]},"intervention":{"type":"string","enum":["no_change","recommend","propose","correct","hold","escalate"]},"dependencies":{"type":"array","items":{"type":"string"}},"owner":{"type":"string"},"state_history":{"type":"array","items":{"type":"object","required":["state","at","actor"],"properties":{"state":{"type":"string"},"at":{"type":"string","format":"date-time"},"actor":{"type":"string"},"reason":{"type":["string","null"]}}}},"release_effect":{"type":"string","enum":["none","track","hold","block"]}
